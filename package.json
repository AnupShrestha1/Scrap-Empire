{
  "name": "scrap-empire",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Scrap Empire: a 2D recycling and manufacturing tycoon for CrazyGames.",
  "scripts": {
    "dev": "vite",
    "dev:cg": "vite --mode crazygames",
    "build": "tsc --noEmit && vite build",
    "build:cg": "tsc --noEmit && vite build --mode crazygames",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "vitest run --config tools/vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
